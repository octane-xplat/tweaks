{
	"name": "@octane-xplat/tweaks-vite",
	"version": "0.1.0",
	"description": "Vite plugin for @octane-xplat/tweaks \u2014 dev websocket, prod stripping, and Save writeback",
	"keywords": [
		"devtools",
		"octane",
		"tweaks",
		"vite-plugin",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/tweaks",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/tweaks",
		"directory": "packages/vite"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p ../tweaks/tsconfig.types.json && tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"typecheck": "tsc -p ../tweaks/tsconfig.types.json && tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@octane-xplat/tweaks": "workspace:*",
		"magic-string": "0.30.21",
		"ws": "8.18.3",
		"@tsrx/oxc": "0.20.0"
	},
	"devDependencies": {
		"@types/ws": "8.18.1",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"vite": ">=5"
	}
}
