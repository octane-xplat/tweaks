{
	"name": "@octane-xplat/tweaks",
	"version": "0.1.0",
	"description": "Live-tweakable values for Octane Xplat apps \u2014 edited from a dev panel, written back to source on Save",
	"keywords": [
		"devtools",
		"octane",
		"tweaks",
		"xplat"
	],
	"homepage": "https://github.com/octane-xplat/tweaks",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/octane-xplat/tweaks",
		"directory": "packages/tweaks"
	},
	"files": [
		"types",
		"src",
		"dist",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"web": "./src/index.ts",
			"native": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./protocol": {
			"types": "./types/protocol.d.ts",
			"default": "./src/protocol.ts"
		},
		"./dev": {
			"types": "./types/generated/dev.d.ts",
			"web": "./src/dev.web.ts",
			"native": "./src/dev.ts",
			"default": "./src/dev.ts"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typegen": "tsc -p tsconfig.types.json",
		"prepack": "pnpm typegen && pnpm build",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.vite.json",
		"build": "pnpm typegen && tsc -p tsconfig.vite.build.json"
	},
	"devDependencies": {
		"octane": "0.14.0",
		"typescript": "5.9.3",
		"@types/ws": "8.18.1",
		"vite": "8.3.0"
	},
	"peerDependencies": {
		"octane": ">=0.14.0 <1",
		"vite": ">=5"
	},
	"dependencies": {
		"magic-string": "0.30.21",
		"ws": "8.18.3",
		"@tsrx/oxc": "0.20.0"
	}
}
