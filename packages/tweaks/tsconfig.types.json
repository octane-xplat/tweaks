{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"moduleSuffixes": ["", ".web", ".native"],
		"lib": ["ESNext", "DOM"],
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "types",
		"rootDir": "src",
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["src/**/*.test.*"]
}
