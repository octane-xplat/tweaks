{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ESNext"],
		"types": ["node"],
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src/vite/**/*", "src/protocol.ts"]
}
