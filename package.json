{
	"name": "octane-xplat-tweaks",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build": "pnpm --filter @octane-xplat/tweaks-vite build && pnpm --filter @octane-xplat/tweaks typegen",
		"test": "node --test links/octane-config.test.cjs packages/tweaks/test/*.test.mts packages/vite/test/*.test.mts",
		"typecheck": "pnpm -r typecheck",
		"lint": "pnpm --filter playground lint",
		"dev:octane": "pnpm install --ignore-scripts --lockfile=false --config.pnpmfile=./links/octane.cjs",
		"dev:published": "./links/dev-published.sh"
	}
}
